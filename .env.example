# Copia a .env para desarrollo local (netlify dev). En producción, estas variables van en Netlify.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo (opcional). Por defecto claude-sonnet-5. Alternativa: claude-opus-5 (más caro, más fino).
CLAUDE_MODEL=claude-sonnet-5
# Cuotas (opcionales)
ENSAYOS_POR_DIA=1
ENSAYOS_GLOBAL_DIA=100
ENSAYOS_POR_MES=3
PRESUPUESTO_DIARIO_CENTAVOS=500
ENSAYO_N_GRATIS=40
# Secreto para firmar tokens (opcional; si falta se deriva de la API key)
# ENSAYO_SECRET=una-cadena-larga-aleatoria
# --- Solo desarrollo ---
# MODELO_MOCK=1                        respuestas simuladas sin llamar al modelo
# PERSONAS_JSONL=./data/build/personas.jsonl   leer personas del archivo local en vez de Blobs
# Token para ver /api/stats?t=... (uso diario: visitas, ensayos, gasto)
# STATS_TOKEN=cadena-larga-aleatoria
